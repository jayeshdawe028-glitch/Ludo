# Discord Developer Portal
DISCORD_APPLICATION_ID=YOUR_APPLICATION_ID
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Public deployment
PUBLIC_DOMAIN=ludocord.example.com
PUBLIC_URL=https://ludocord.example.com

# Server
PORT=3000
DB_PATH=/data/ludocord.db

# Bot links - replace before release
BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_APPLICATION_ID&scope=bot%20applications.commands&permissions=0
COMMUNITY_URL=https://discord.com/invite/REPLACE_ME
